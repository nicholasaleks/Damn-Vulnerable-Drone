<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='gimbal_small_2d'>
    <pose>0 0 0.18 0 0 0</pose>

    <link name='base_link'>
       <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <visual name='base_main_viz'>
        <geometry>
         <mesh>
           <scale>0.001 0.001 0.001</scale>
           <uri>model://gimbal_small_2d/meshes/base_main.dae</uri>
         </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/FlatBlack</name>
          </script>
        </material>
      </visual>

     <visual name='base_arm_viz'>
        <geometry>
         <mesh>
           <scale>0.001 0.001 0.001</scale>
           <uri>model://gimbal_small_2d/meshes/base_arm.dae</uri>
         </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/FlatBlack</name>
          </script>
        </material>
      </visual>

      <collision name='base_col'>
        <pose>0.01 0.075 -0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.05 0.15</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name='tilt_link'>
       <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
     <visual name='tilt_viz'>
        <pose>0 0 -0.005 0 0 0</pose>
        <geometry>
         <mesh>
           <scale>0.001 0.001 0.001</scale>
           <uri>model://gimbal_small_2d/meshes/tilt.dae</uri>
         </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>

     <collision name='tilt_col'>
        <pose>0 0 -0.005 0 0 0</pose>
        <geometry>
         <mesh>
           <scale>0.001 0.001 0.001</scale>
           <uri>model://gimbal_small_2d/meshes/tilt.dae</uri>
         </mesh>
        </geometry>
      </collision>

      <visual name='camera_viz'>
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>

         <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
     </visual>

      <collision name='camera_col'>
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
     </collision>

      <sensor name="camera" type="camera">
        <pose>0 0 0 -1.57 -1.57 0</pose>
        <camera>
          <horizontal_fov>2.0</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>
        <!--
          ROS 2 Humble gazebo_ros_pkgs camera plugin.

          The legacy ROS 1 flat fields (<cameraName>, <imageTopicName>,
          <frameName>, <hackBaseline>, <distortionK*>) have been replaced
          by a <ros> sub-element plus snake_case keys.

          With <namespace>/webcam</namespace>, the plugin publishes:
            /webcam/image_raw      (sensor_msgs/msg/Image)
            /webcam/camera_info    (sensor_msgs/msg/CameraInfo)

          These topic names are intentionally identical to what the ROS 1
          plugin produced on the master branch, so the companion-computer
          subscribers and every attack walkthrough that targets
          /webcam/image_raw keep working unmodified.
        -->
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
              <ros>
                <namespace>/webcam</namespace>
              </ros>
              <frame_name>camera_link</frame_name>
              <hack_baseline>0.07</hack_baseline>
              <distortion_k1>0.0</distortion_k1>
              <distortion_k2>0.0</distortion_k2>
              <distortion_k3>0.0</distortion_k3>
              <distortion_t1>0.0</distortion_t1>
              <distortion_t2>0.0</distortion_t2>
          </plugin>
      </sensor>

    </link>

    <!--
      Pan link (NEW on ros2-migration). Inserted between base_link and
      tilt_link to give the gimbal a yaw axis. Minimal inertial because
      it has no mass of its own; it exists purely to host the pan joint.
    -->
    <link name='pan_link'>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
    </link>

    <!--
      Pan joint (NEW). Rotates pan_link about Z relative to base_link.
      Limits: +/-90 deg, matching typical small-gimbal pan range.
    -->
    <joint name='pan_joint' type='revolute'>
      <parent>base_link</parent>
      <child>pan_link</child>

      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.5</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
        <limit>
          <lower>-1.5707963</lower>
          <upper>1.5707963</upper>
          <effort>10</effort>
          <velocity>-1</velocity>
        </limit>
      </axis>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <joint name='tilt_joint' type='revolute'>
       <parent>pan_link</parent>
       <child>tilt_link</child>

      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>

      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>0.5</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
        <limit>
          <lower>-0.1</lower>
          <upper>3.14159265</upper>
          <effort>10</effort>
          <velocity>-1</velocity>
        </limit>
      </axis>
      <pose>0 0 0.02 0 0 0</pose>
    </joint>

    <!--
      The libGimbalSmall2dPlugin.so plugin that lived here on the master
      branch was a pitch-only Gazebo plugin tied to one servo channel.
      On ros2-migration the gimbal is controlled by the
      libgazebo_ros_joint_pose_trajectory.so plugin in the world file,
      which moves both pan and tilt joints from a /gimbal/set_joint_trajectory
      ROS 2 topic. See companion-computer/interface/gimbal_bridge.py for
      the bridge that translates web-UI clicks (and MAV_CMD_DO_MOUNT_CONTROL)
      into JointTrajectory messages.
    -->
  </model>
</sdf>
